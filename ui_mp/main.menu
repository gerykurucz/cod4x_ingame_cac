#include "ui/menudef.h"

#define CHOICE_X_START			0
#define CHOICE_Y_START			168

#define CHOICE_GROUP			"main"
#define CHOICE_SEP_1			2
#define CHOICE_SEP_2			4
#define CHOICE_SEP_3			8

#define STYLE_PC	1
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

{
	menuDef
	{
		name			"cdkey_menu"
	}

	assetGlobalDef
	{
		fadeClamp		1
		fadeCycle		1
		fadeAmount		0.1
	}
	menuDef
	{
		name			"main"
		fullScreen		1
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED
		onOpen
		{
			open main_text;
			uiScript addPlayerProfiles;
			uiScript openMenuOnDvar com_playerProfile "" player_profile;
			uiScript openMenuOnDvarNot ui_playerProfileCount 1 player_profile;
			uiScript stopRefresh;
			setdvar ui_showEndOfGame "0";
			setdvar sv_cheats "1";
			setdvar promod_mode "strat";
		}
	}

	menuDef
	{
		name			"main_text"
		fullScreen		1
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED

		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			FULLSCREEN_WIDE
			background		"animbg_back"
			visible			1
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			FULLSCREEN_WIDE
			background		"animbg_front"
			visible			1
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			FULLSCREEN_WIDE
			background		"animbg_front2"
			visible			1
			decoration
		}

		CHOICE_BUTTON_VIS( 1, "@MENU_AUTO_UPDATE", open auconfirm;, when( dvarbool( cl_updateAvailable ) && !localvarBool( ui_hideBack ) ) )

// --- FEKETE HÁTTÉR PANEL ---
        itemDef
        {
            group            grpControlbutton
            rect             170 173 300 130 // Szélesség: 300, Magasság: 130 (hogy beférjen minden)
            style            WINDOW_STYLE_FILLED
            border           1
            bordercolor      0.5 0.5 0.5 0.5
            forecolor        1 1 1 1
            backcolor        0 0 0 0.85
            visible          when( localvarBool( ui_about ) );
            decoration
        }
        
        // --- SZÖVEGEK (A PANELHEZ IGAZÍTVA) ---
        itemDef
        {
            text            "Nektum Mod v0.9 Open Beta"
            style           0
            textscale       0.3
            textstyle       3
            rect            170 195 300 20 // Ugyanaz a kezdő X (170) és szélesség (300)
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       1 1 1 1
            visible         when( localvarBool( ui_about ) );
            decoration
        }

        itemDef
        {
            text            "Developed by Nobody"
            style           0
            textscale       0.2
            textstyle       3
            rect            170 210 300 20
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       1 1 1 0.8
            visible         when( localvarBool( ui_about ) );
            decoration
        }

        itemDef
        {
            text            "Aiming to give you the best COD4X experience"
            style           0
            textscale       0.22
            textstyle       3
            rect            170 230 300 20
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       1 1 1 1
            visible         when( localvarBool( ui_about ) );
            decoration
        }

        itemDef
        {
            text            "Get all your weapons with $unlock command."
            style           0
            textscale       0.22
            textstyle       3
            rect            170 245 300 20
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       1 0.8 0.2 1
            visible         when( localvarBool( ui_about ) );
            decoration
        }

        itemDef
        {
            text            "Including our own anticheat: Nektum Shield"
            style           0
            textscale       0.22
            textstyle       3
            rect            170 260 300 20
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       1 1 1 1
            visible         when( localvarBool( ui_about ) );
            decoration
        }

        itemDef
        {
            text            "Contact us on Discord: dsc.gg/nektum"
            style           0
            textscale       0.22
            textstyle       3
            rect            170 285 300 20
            textalign       ITEM_ALIGN_CENTER
            textalignx      0
            textaligny      0
            textfont        UI_FONT_NORMAL
            forecolor       0.4 0.6 1 1
            visible         when( localvarBool( ui_about ) );
            decoration
        }

		CHOICE_BUTTON_BG( 2, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_HIGHLIGHT( 2, 2 )
		itemDef
		{
			type			ITEM_TYPE_BUTTON
			rect			CHOICE_RECT( 2 )
			exp				text( "About Nektum" );
			textfont		CHOICE_TEXTFONT
			textscale		CHOICE_TEXTSIZE
			textstyle		CHOICE_TEXTSTYLE
			textAlign		CHOICE_TEXTALIGN
			textAlignX		CHOICE_TEXT_OFFSET_X
			forecolor		CHOICE_TEXTCOLOR
			visible			when( !localvarBool( ui_hideBack ) )
			onFocus
			{
				play CHOICE_FOCUS_SOUND;
				setLocalVarInt ui_highlight 2;
				setLocalVarString ui_choicegroup CHOICE_GROUP;
				setLocalvarBool ui_about 1;
			}
			leaveFocus
			{
				setLocalVarInt ui_highlight 0;
				setLocalvarBool ui_about 0;
			}
		}
		CHOICE_SEPARATOR_VIS( CHOICE_SEP_1, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_BUTTON_VIS( 3, "@MENU_JOIN_GAME", open pc_join_unranked;, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_SEPARATOR_VIS( CHOICE_SEP_2, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_BUTTON_VIS( 4, "@MENU_SELECT_PROFILE", setdvar ui_playerProfileAlreadyChosen 0; open player_profile;, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_BUTTON_VIS( 5, "@MENU_CONTROLS", open main_controls;, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_BUTTON_VIS( 6, "@MENU_OPTIONS", open main_options;, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_SEPARATOR_VIS( CHOICE_SEP_3, when( !localvarBool( ui_hideBack ) ) )
		CHOICE_BUTTON_VIS( 7, "@MENU_QUIT", open quit_popmenu, when( !localvarBool( ui_hideBack ) ) )
	}

	#include "ui/choices_setup_popmenu.menu"
}